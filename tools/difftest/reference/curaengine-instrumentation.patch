+            {
+                std::ostringstream ss;
+                ss << "overhang mesh=" << mesh_idx << " layer=" << layer_idx << "\n";
+                ss << " overhang\n" << dbg::shapeStr(mesh.overhang_areas[layer_idx]);
+                if (layer_idx < mesh.full_overhang_areas.size())
+                {
+                    ss << " full_overhang\n" << dbg::shapeStr(mesh.full_overhang_areas[layer_idx]);
+                }
+                dbg::write(ss.str());
+            }
+        }
+    }
+    {
+        std::ostringstream ss;
+        ss << tag << " mesh=-1 layer=-1 generated=" << int(storage.support.generated) << " max_filled=" << storage.support.layer_nr_max_filled_layer
+           << " nlayers=" << storage.support.supportLayers.size() << "\n";
+        dbg::write(ss.str());
+    }
+    for (size_t layer_idx = 0; layer_idx < storage.support.supportLayers.size(); layer_idx++)
+    {
+        const SupportLayer& layer = storage.support.supportLayers[layer_idx];
+        std::ostringstream ss;
+        ss << tag << " mesh=-1 layer=" << layer_idx << " nparts=" << layer.support_infill_parts.size() << "\n";
+        for (const SupportInfillPart& part : layer.support_infill_parts)
+        {
+            ss << " part w=" << part.support_line_width_ << " insets=" << part.inset_count_to_generate_ << " cld=" << part.custom_line_distance_
+               << " frac=" << int(part.use_fractional_config_) << " bb=" << part.outline_boundary_box_.min_.X << "," << part.outline_boundary_box_.min_.Y << ","
+               << part.outline_boundary_box_.max_.X << "," << part.outline_boundary_box_.max_.Y << "\n";
+            ss << " outline\n" << dbg::shapeStr(part.outline_);
+            if (with_infill)
+            {
+                for (size_t d = 0; d < part.infill_area_per_combine_per_density_.size(); d++)
+                {
+                    for (size_t c = 0; c < part.infill_area_per_combine_per_density_[d].size(); c++)
+                    {
+                        ss << " infill d=" << d << " c=" << c << "\n" << dbg::shapeStr(part.infill_area_per_combine_per_density_[d][c]);
+                    }
+                }
+                ss << " toolpaths\n" << dbg::toolpathsStr(part.wall_toolpaths_);
+            }
+        }
+        ss << " bottom\n" << dbg::shapeStr(layer.support_bottom);
+        ss << " roof\n" << dbg::shapeStr(layer.support_roof);
+        ss << " fractional_roof\n" << dbg::shapeStr(layer.support_fractional_roof);
+        ss << " mesh_drop_down\n" << dbg::shapeStr(layer.support_mesh_drop_down);
+        ss << " support_mesh\n" << dbg::shapeStr(layer.support_mesh);
