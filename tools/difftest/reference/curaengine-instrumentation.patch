+void curaportDumpAdhesion(const cura::SliceDataStorage& storage)
+{
+    using namespace cura;
+    if (! dbg::enabled())
+    {
+        return;
+    }
+    auto linesStr = [](const auto& lines)
+    {
+        std::ostringstream ss;
+        for (const auto& line : lines)
+        {
+            ss << "  line " << line.size() << ":";
+            for (const Point2LL& p : line)
+            {
+                ss << " " << p.X << "," << p.Y;
+            }
+            ss << "\n";
+        }
+        return ss.str();
+    };
+    for (size_t extruder_nr = 0; extruder_nr < MAX_EXTRUDERS; extruder_nr++)
+    {
+        for (size_t inset_idx = 0; inset_idx < storage.skirt_brim[extruder_nr].size(); inset_idx++)
+        {
+            std::ostringstream ss;
+            ss << "adhesion mesh=" << extruder_nr << " layer=" << inset_idx << " n=" << storage.skirt_brim[extruder_nr][inset_idx].size() << "\n";
+            for (const PolylinePtr& line : storage.skirt_brim[extruder_nr][inset_idx])
+            {
+                char t = 'O';
+                if (std::dynamic_pointer_cast<const Polygon>(line))
+                {
+                    t = 'P';
+                }
+                else if (const auto closed = std::dynamic_pointer_cast<const ClosedPolyline>(line))
+                {
+                    t = closed->isExplicitlyClosed() ? 'C' : 'c';
+                }
+                ss << "  " << t << " " << line->size() << ":";
+                for (const Point2LL& p : *line)
+                {
+                    ss << " " << p.X << "," << p.Y;
+                }
+                ss << "\n";
+            }
+            dbg::write(ss.str());
+        }
+    }
+    {
+        std::ostringstream ss;
+        ss << "adhesion mesh=-1 layer=-1\n";
+        ss << " support_brim\n" << linesStr(storage.support_brim);
+        ss << " raft_base\n" << dbg::shapeStr(storage.raft_base_outline);
+        ss << " raft_interface\n" << dbg::shapeStr(storage.raft_interface_outline);
+        ss << " raft_surface\n" << dbg::shapeStr(storage.raft_surface_outline);
+        ss << " draft_shield\n" << dbg::shapeStr(storage.draft_protection_shield);
+        dbg::write(ss.str());
+    }
+    for (size_t layer_idx = 0; layer_idx < storage.ooze_shield.size(); layer_idx++)
+    {
+        std::ostringstream ss;
+        ss << "adhesion mesh=-2 layer=" << layer_idx << "\n" << dbg::shapeStr(storage.ooze_shield[layer_idx]);
+        dbg::write(ss.str());
+    }
+}
