+// Debug dumps for comparing against the Rust port (enabled by env CURA_DUMP=<file>).
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include "geometry/Shape.h"
+#include "utils/ExtrusionLine.h"
+
+namespace cura::dbg
+{
+inline FILE* sink()
+{
+    static FILE* f = []() -> FILE*
+    {
+        const char* p = std::getenv("CURA_DUMP");
+        return p ? std::fopen(p, "w") : nullptr;
+    }();
+    return f;
+}
+inline bool enabled()
+{
+    return sink() != nullptr;
+}
+inline void write(const std::string& s)
+{
+    static std::mutex m;
+    std::lock_guard<std::mutex> lock(m);
+    if (sink())
+    {
+        std::fwrite(s.data(), 1, s.size(), sink());
+        std::fflush(sink());
+    }
+}
+inline std::string shapeStr(const Shape& shape)
+{
+    std::ostringstream ss;
+    for (const Polygon& poly : shape)
+    {
+        ss << "  poly " << poly.size() << ":";
+        for (const Point2LL& p : poly)
+        {
+            ss << " " << p.X << "," << p.Y;
+        }
+        ss << "\n";
+    }
+    return ss.str();
+}
+inline std::string toolpathsStr(const std::vector<VariableWidthLines>& paths)
+{
+    std::ostringstream ss;
+    for (size_t i = 0; i < paths.size(); i++)
+    {
+        for (const ExtrusionLine& line : paths[i])
+        {
+            ss << "  inset " << i << " line idx=" << line.inset_idx_ << " odd=" << int(line.is_odd_) << " closed=" << int(line.is_closed_) << " n=" << line.junctions_.size() << ":";
+            for (const ExtrusionJunction& j : line.junctions_)
+            {
+                ss << " " << j.p_.X << "," << j.p_.Y << "," << j.w_;
+            }
+            ss << "\n";
+        }
+    }
+    return ss.str();
+}
+} // namespace cura::dbg
