// Windows resources for curust-setup.exe: icon, manifest (administrator rights, visual
// styles, DPI awareness) and version information. Compiled to setup.res with `llvm-rc setup.rc`.
#pragma code_page(65001)
1 ICON "curust.ico"
1 24 "setup.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Curust contributors"
      VALUE "FileDescription", "Curust Installer"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "curust-installer"
      VALUE "LegalCopyright", "AGPL-3.0-or-later"
      VALUE "OriginalFilename", "curust-installer.exe"
      VALUE "ProductName", "Curust"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
